---
import Icon from './Icon.astro';
import { url } from '../data/site.js';
import { content, getLang, href, fill } from '../i18n/index.js';
const lang = getLang(Astro);
const { nav, links, site, ui } = content(lang);
const f = ui.footer;
const year = new Date().getFullYear();
---
<footer class="ftr" id="footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={href(lang)}><img src={url('/favicon.svg')} alt="" width="34" height="34" /><span>{site.brand}{site.brandTail && <span class="sub">{site.brandTail}</span>}</span></a>
        <p class="latin">{site.latin}</p>
        <p class="small">{f.about}</p>
      </div>
      <div class="cols">
        <nav class="col" aria-label={ui.mainNav}>
          <ul>
            {nav.map((n) => <li><a href={href(lang, `/#${n.id}`)}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="col">
          <h3>{f.orders}</h3>
          <ul>
            <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
            <li><a href={links.docs} target="_blank" rel="noopener noreferrer">{f.docs} <Icon name="ext" size={12} /></a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="bottom">
      <p>{fill(f.legal, { year, id: site.studentId, course: site.course, academicYear: site.year, licence: site.licence })}</p>
      <p>{fill(f.updated, { updated: site.updated })}</p>
      <p><a href="#top">{f.top}</a></p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--dusk); color: #cfc6b2; padding: clamp(3rem, 6vw, 5rem) 0 2rem; border-top: 1px solid #2a2f45; font-size: .95rem; }
  .top { display: grid; gap: 3rem; grid-template-columns: minmax(240px, 1.4fr) 2fr; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: #f1e8d4; text-decoration: none; font: 600 1.3rem var(--font-display); letter-spacing: .06em; margin-bottom: .3rem; }
  .brand .sub { font-weight: 400; opacity: .8; }
  .brand img { border-radius: 8px; flex: none; }
  .latin { color: #d7b98d; margin: 0 0 1rem; }
  .small { font-size: .92rem; max-width: 34ch; }
  .cols { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  h3 { font: 500 .72rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: #d7b98d; margin-bottom: .9rem; }
  h3 a { color: inherit; text-decoration: none; } h3 a:hover { color: #fff; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .col a { color: #cfc6b2; text-decoration: none; }
  .col a:hover { color: #fff; text-decoration: underline; }
  .bottom { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #2a2f45; display: flex; flex-wrap: wrap; gap: .4rem 2rem; justify-content: space-between; font: 400 .78rem/1.6 var(--font-mono); color: #9d9684; }
  .bottom p { margin: 0; max-width: 62ch; }
  .bottom a { color: #d7b98d; }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr; } }
</style>
