---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import Bird from '../../components/Bird.astro';
import { url } from '../../data/site.js';
import { content, getLang } from '../../i18n/index.js';
export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'sk' } }];
const lang = getLang(Astro);
const c = content(lang);
const { site, links, docs, roadmap, ui } = c;
const t = c.p.home;
const mail = `mailto:${links.email}?subject=${encodeURIComponent(t.order.subject)}`;
---
<Base title={site.name} description={site.description}>
  <Hero />

  <section class="block" id="about">
    <div class="wrap split">
      <div>
        <div class="sec-head reveal">
          <p class="eyebrow">{t.about.eyebrow}</p>
          <h2>{t.about.title}</h2>
        </div>
        {t.about.text.map((p) => <p class="reveal">{p}</p>)}
      </div>
      <article class="card reveal" id="why">
        <p class="eyebrow">{t.why.eyebrow}</p>
        <h3>{t.why.title}</h3>
        <p>{t.why.text}</p>
      </article>
    </div>
  </section>

  <section class="block tint" id="how">
    <div class="wrap split">
      <div>
        <div class="sec-head reveal">
          <p class="eyebrow">{t.how.eyebrow}</p>
          <h2>{t.how.title}</h2>
        </div>
        <ol class="flow">
          {t.how.steps.map((f, i) => (
            <li class="reveal"><span class="n">{String(i + 1).padStart(2, '0')}</span><div><h3>{f.title}</h3><p>{f.text}</p></div></li>
          ))}
        </ol>
        <p class="battery reveal"><Icon name="plug" size={18} /> {t.how.battery}</p>
      </div>
      <div class="notes-art reveal" aria-hidden="true">
        <Bird class="big" />
        <p class="latin cap">{site.latin}</p>
      </div>
    </div>
  </section>

  <section class="block" id="docs">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.docs.eyebrow}</p>
        <h2>{t.docs.title}</h2>
        <p>{t.docs.lead}</p>
      </div>
      <div class="grid g3">
        {docs.map((d) => (
          <a class="card doc reveal" href={d.href} target="_blank" rel="noopener noreferrer">
            <img src={url(`/img/${d.img}.webp`)} alt={d.alt} width={d.w} height={d.h} loading="lazy" decoding="async" />
            <h3>{d.title}</h3>
            <p>{d.text}</p>
            <p class="go">{t.docs.read} · KNIFE-{String(d.knife).padStart(3, '0')} <Icon name="ext" size={14} /></p>
          </a>
        ))}
      </div>
      <p class="reveal" style="margin-top:2rem"><a class="btn ghost" href={links.docs} target="_blank" rel="noopener noreferrer">{t.docs.all} <Icon name="ext" size={16} /></a></p>
    </div>
  </section>

  <section class="block night" id="model">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.model.eyebrow}</p>
        <h2>{t.model.title}</h2>
        <p>{t.model.lead}</p>
      </div>
      <div class="reveal"><ModelViewer /></div>
    </div>
  </section>

  <section class="block" id="roadmap">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">{t.roadmap.eyebrow}</p>
        <h2>{t.roadmap.title}</h2>
      </div>
      <ol class="rail">
        {roadmap.map((m) => (
          <li class:list={['reveal', m.state]}>
            <span class="dot" aria-hidden="true">{m.state === 'done' ? <Icon name="check" size={14} /> : ''}</span>
            <p class="mono when">{m.when} · <span class:list={['pill', m.state === 'done' ? 'ok' : 'wip']}>{ui.status[m.state]}</span></p>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block night band" id="order">
    <div class="wrap band-in">
      <div class="reveal">
        <p class="eyebrow">{t.order.eyebrow}</p>
        <h2>{t.order.title}</h2>
        <p class="lead">{t.order.lead}</p>
      </div>
      <div class="reveal actions">
        <a class="btn primary" href={mail}>{t.order.button}</a>
        <a class="mail mono" href={mail}>{links.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .flow { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.6rem; }
  .flow li { display: grid; grid-template-columns: 3.4rem 1fr; gap: 1rem; }
  .flow .n { font: 500 .85rem var(--font-mono); color: var(--rust); border: 1px solid currentColor; width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center; margin-top: .2rem; }
  .flow h3 { margin-bottom: .15em; } .flow p { margin: 0; color: var(--ink-soft); }
  .battery { display: flex; align-items: center; gap: .6rem; margin: 2rem 0 0; padding: .9rem 1.1rem; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper); font-weight: 500; }
  .battery :global(svg) { color: var(--rust); flex: none; }

  .notes-art { background: var(--dusk); border-radius: 18px; padding: 2.4rem 1.6rem 1.4rem; color: #05060c; position: relative; overflow: hidden; background-image: radial-gradient(80% 70% at 70% 100%, rgb(232 165 89 / .45), transparent 70%); }
  .notes-art :global(.big) { width: 100%; filter: drop-shadow(0 0 1px rgb(241 190 120 / .6)); }
  .notes-art .cap { color: #d7b98d; text-align: center; margin: 1.2rem 0 0; font-size: 1.05rem; }

  .doc { display: flex; flex-direction: column; color: inherit; text-decoration: none; transition: transform .25s, box-shadow .25s; }
  .doc:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .doc img { display: block; width: 100%; height: 220px; object-fit: cover; border-radius: 10px; margin-bottom: 1.1rem; }
  .doc p { color: var(--ink-soft); }
  .doc .go { margin-top: auto; padding-top: .6rem; font: 500 .78rem var(--font-mono); letter-spacing: .05em; color: var(--rust); display: flex; align-items: center; gap: .4rem; }

  .rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.6rem 1.4rem; }
  .rail li { position: relative; padding-top: 2.4rem; border-top: 1px solid var(--rule); }
  .rail .dot { position: absolute; top: -9px; left: 0; width: 17px; height: 17px; border-radius: 50%; background: var(--paper); border: 2px solid var(--amber); display: grid; place-items: center; color: #fff; }
  .rail li.done .dot { background: var(--moss); border-color: var(--moss); }
  .rail .when { margin: 0 0 .4rem; font-size: .74rem; letter-spacing: .08em; color: var(--bark); text-transform: uppercase; }
  .rail h3 { font-size: 1.15rem; margin-bottom: .3em; } .rail p:last-child { color: var(--ink-soft); font-size: .96rem; margin: 0; }

  .band { overflow: hidden; background: linear-gradient(120deg, #151932, #2a2644 60%, #5a3a3e); }
  .band .lead { color: var(--nt); }
  .band-in { display: grid; gap: 2rem 4rem; grid-template-columns: 1.4fr 1fr; align-items: center; }
  .actions { display: flex; flex-direction: column; gap: .8rem; align-items: stretch; text-align: center; }
  .mail { color: inherit; font-size: .9rem; }
  @media (max-width: 820px) { .band-in { grid-template-columns: 1fr; } }
</style>
