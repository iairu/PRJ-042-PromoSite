---
// This page was folded into the home page; old links land there.
import { getLang, href } from '../../i18n/index.js';
export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'sk' } }];
const to = href(getLang(Astro));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Nightjar Gift</title>
  </head>
  <body><p><a href={to}>Nightjar Gift</a></p></body>
</html>
